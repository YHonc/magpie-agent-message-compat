{
  "name": "magpie-agent-message-compat",
  "version": "0.1.2",
  "type": "module",
  "description": "Codex MultiAgent V2 message compatibility for selected third-party Magpie routes, with plaintext provenance checks",
  "license": "MIT",
  "author": "YHonc",
  "repository": {"type": "git", "url": "https://github.com/YHonc/magpie-agent-message-compat.git"},
  "homepage": "https://github.com/YHonc/magpie-agent-message-compat#readme",
  "bugs": {"url": "https://github.com/YHonc/magpie-agent-message-compat/issues"},
  "keywords": ["magpie-plugin", "magpie", "codex", "multi-agent", "middleware"],
  "scripts": {"test": "node test.mjs"},
  "files": ["common.js", "compat.middleware.js", "provenance.hooks.mjs", "README.md", "LICENSE", "CHANGELOG.md", "evidence/"],
  "magpie": {
    "name": "Agent Message Compat",
    "middleware": "./compat.middleware.js",
    "hooks": "./provenance.hooks.mjs",
    "options": {
      "targets": [],
      "gatewayTimeoutMs": 2000,
      "ledgerMaxEntries": 2048,
      "ledgerMaxAgeDays": 30
    }
  }
}
